#!/bin/bash
# Delete all temporary and build files

# Exit on error
set -e

cd "$(dirname "$0")/.." # great-docs builds at the repo root

start=$SECONDS

echo "Removing build files..."
rm -rvf great-docs           # ephemeral Great Docs build directory (includes _site)
rm -rvf _freeze              # Quarto execution cache
rm -rvf .jupyter_cache/
rm -rvf .virtual_documents/
rm -rvf tutorials/.ipynb_checkpoints/
rm -rvf user_guide/.ipynb_checkpoints/
find . -name '*.quarto_ipynb' -not -path './.git/*' -delete -print

duration=$(( SECONDS - start ))
echo "Cleaned after $duration seconds."
